{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "dev": "pnpm build && node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:browser": "playwright test",
    "test:audio": "node scripts/audio-proof.mjs",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "blockly": "13.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "acorn": "8.19.0"
  }
}
